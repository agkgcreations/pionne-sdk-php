{
    "name": "pionne/pionne",
    "description": "Error monitoring SDK for PHP \u2014 Pionne. Works standalone, with Laravel (auto-discover) and with Symfony (event listener).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://pionne.agkgcreations.fr",
    "keywords": [
        "pionne",
        "error-monitoring",
        "crash-reporting",
        "laravel",
        "symfony",
        "observability"
    ],
    "support": {
        "issues": "https://github.com/agkgcreations/pionne-sdk-php/issues",
        "source": "https://github.com/agkgcreations/pionne-sdk-php"
    },
    "authors": [
        {
            "name": "AGKG Creations",
            "homepage": "https://agkgcreations.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/contracts": "^10.0|^11.0",
        "symfony/event-dispatcher": "^6.0|^7.0",
        "symfony/http-kernel": "^6.0|^7.0"
    },
    "suggest": {
        "illuminate/contracts": "Required for the Laravel auto-discover service provider.",
        "symfony/http-kernel": "Required for the Symfony exception listener."
    },
    "autoload": {
        "psr-4": {
            "Pionne\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pionne\\Laravel\\PionneServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
